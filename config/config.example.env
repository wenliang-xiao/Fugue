# Fugue 配置示例
# 复制为 config/config.env 并填入实际值。
# 注意：语音前端（DASHSCOPE_API_KEY / DOUBAO_API_KEY 等）走 qwen-audio-agent 自己的 config.env，
#       本文件只负责「多 harness 编排 + 路由 + 飞书入口」。

# ── Gateway 地址（默认本机 3101）──
AGENT_CONDUCTOR_GATEWAY_URL=http://127.0.0.1:3101

# ── 后台 harness：领域专家分工 ──
#   pi       = 工作主力助手（默认路由目标）
#   opencode = 备选能力（写代码 / 修 bug）
#   hermes   = 财经助手（投资 / 股票 / 基金）
#   dsh      = 长程深度调研（DeepSeek Harness）
AGENT_CONDUCTOR_BACKEND_PI=enabled
AGENT_CONDUCTOR_BACKEND_OPENCODE=enabled
AGENT_CONDUCTOR_BACKEND_HERMES=enabled
AGENT_CONDUCTOR_BACKEND_DSH=enabled

# ── Hermes 远端（阿里云/腾讯云），SSH 隧道透传 ACP ──
AGENT_CONDUCTOR_HERMES_SSH_HOST=user@your-cloud-host

# ── 默认 backend（工作主力 pi）──
AGENT_CONDUCTOR_DEFAULT_BACKEND=pi

# ── 领域路由：backendId=关键词1|关键词2|...（任务命中关键词则路由到该 backend）──
AGENT_CONDUCTOR_ROUTE_HERMES=财经|投资|股票|基金|ETF|行情|量化|大盘|财报|交易
AGENT_CONDUCTOR_ROUTE_DSH=深度调研|research|长程|综述|行业研究|分析报告
# AGENT_CONDUCTOR_ROUTE_OPENCODE=写代码|修bug|重构|实现

# ── 飞书入口（可选，启用时填应用凭据）──
AGENT_CONDUCTOR_FEISHU_ENABLED=false
AGENT_CONDUCTOR_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
AGENT_CONDUCTOR_FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── qwen-audio-agent 体验调优（可选，launcher 已设默认值，可覆盖）──
# 播报结果最大字符数：默认 6000 会导致播报=全文朗读；Fugue 默认收窄到 500
# QWEN_AUDIO_AGENT_RESULT_CONTEXT_MAX_CHARS=500
# 后台工作目录：默认 ~/.config/qwaudio/data/workspace；Fugue 默认设为项目当前目录
# QWAUDIO_WORKSPACE=/path/to/your/workspace
