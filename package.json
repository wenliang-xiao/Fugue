{
  "name": "fugue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "全双工、多端可达、可委派多种 agent harness 的对话编排中枢",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "poc": "node poc/run-conformance.mjs",
    "start": "tsx src/launcher.ts",
    "inspect": "tsx src/inspect.ts",
    "postinstall": "patch-package",
    "daemon:install": "tsx scripts/daemon.ts install",
    "daemon:uninstall": "tsx scripts/daemon.ts uninstall",
    "daemon:start": "tsx scripts/daemon.ts start",
    "daemon:stop": "tsx scripts/daemon.ts stop",
    "daemon:status": "tsx scripts/daemon.ts status"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "qwen-audio-agent": "^2.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
